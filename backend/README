// npm init -y // to initialise node
// npm install express // to install express
// node server.js // to run server.js or to start server
//-------------------------------------------------------------------
// Express Notes
//-------------------------------
// 100** - Informational
//-------------------------------
// 200** - Success
// 200 - Everything worked as expected
// 201 - Submitted new resource successfully created
//-------------------------------
// 300** - Redirection
// 301 - redirection / moved directly
//-------------------------------
// 400** - failed / error from user
// 400- bad request
// 401 - Unauthorised / invalid cred
// 403 - not allowed to access
// 404- Resource/url not found
// 429 - Too many request
//-------------------------------
// 500\*\* - Server Error
// 500 - Internal Server Error
// 503- Service Unavailable / temply down / overloaded
//-------------------------------
// npm i @upstash/ratelimit@2.0.5 @upstash/redis@1.34.9
